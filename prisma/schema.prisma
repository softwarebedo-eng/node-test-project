generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model WpUser {
  id                BigInt                    @id @default(autoincrement()) @map("ID") @db.UnsignedBigInt
  userLogin         String                    @default("") @map("user_login") @db.VarChar(60)
  userPass          String                    @default("") @map("user_pass") @db.VarChar(255)
  userNicename      String                    @default("") @map("user_nicename") @db.VarChar(50)
  userEmail         String                    @default("") @map("user_email") @db.VarChar(100)
  userUrl           String                    @default("") @map("user_url") @db.VarChar(100)
  userRegistered    DateTime                  @default(dbgenerated("('0000-00-00 00:00:00')")) @map("user_registered") @db.DateTime(0)
  userActivationKey String                    @default("") @map("user_activation_key") @db.VarChar(255)
  userStatus        Int                       @default(0) @map("user_status")
  displayName       String                    @default("") @map("display_name") @db.VarChar(250)
  customerSalesAs   BedoCustomerSale?         @relation("CustomerUser")
  salesForCustomers BedoCustomerSale[]        @relation("SalesUser")
  dashboardAccess   BedoDashboardUserAccess[]
  phoneNumbers      BedoUserPhoneNumber[]     @ignore
  productLicenses   BedoProductLicense[]

  @@index([userEmail], map: "user_email")
  @@index([userLogin], map: "user_login_key")
  @@index([userNicename], map: "user_nicename")
  @@map("wp_users")
}

model WpUsermeta {
  umetaId   BigInt  @id @default(autoincrement()) @map("umeta_id") @db.UnsignedBigInt
  userId    BigInt  @default(0) @map("user_id") @db.UnsignedBigInt
  metaKey   String? @map("meta_key") @db.VarChar(255)
  metaValue String? @map("meta_value") @db.LongText

  @@index([metaKey(length: 191)], map: "meta_key")
  @@index([userId], map: "user_id")
  @@map("wp_usermeta")
}

model WpPost {
  id                  BigInt   @id @default(autoincrement()) @map("ID") @db.UnsignedBigInt
  postAuthor          BigInt   @default(0) @map("post_author") @db.UnsignedBigInt
  postDate            DateTime @default(dbgenerated("('0000-00-00 00:00:00')")) @map("post_date") @db.DateTime(0)
  postDateGmt         DateTime @default(dbgenerated("('0000-00-00 00:00:00')")) @map("post_date_gmt") @db.DateTime(0)
  postContent         String   @map("post_content") @db.LongText
  postTitle           String   @map("post_title") @db.Text
  postExcerpt         String   @map("post_excerpt") @db.Text
  postStatus          String   @default("publish") @map("post_status") @db.VarChar(20)
  commentStatus       String   @default("open") @map("comment_status") @db.VarChar(20)
  pingStatus          String   @default("open") @map("ping_status") @db.VarChar(20)
  postPassword        String   @default("") @map("post_password") @db.VarChar(255)
  postName            String   @default("") @map("post_name") @db.VarChar(200)
  toPing              String   @map("to_ping") @db.Text
  pinged              String   @map("pinged") @db.Text
  postModified        DateTime @default(dbgenerated("('0000-00-00 00:00:00')")) @map("post_modified") @db.DateTime(0)
  postModifiedGmt     DateTime @default(dbgenerated("('0000-00-00 00:00:00')")) @map("post_modified_gmt") @db.DateTime(0)
  postContentFiltered String   @map("post_content_filtered") @db.LongText
  postParent          BigInt   @default(0) @map("post_parent") @db.UnsignedBigInt
  guid                String   @default("") @map("guid") @db.VarChar(255)
  menuOrder           Int      @default(0) @map("menu_order")
  postType            String   @default("post") @map("post_type") @db.VarChar(20)
  postMimeType        String   @default("") @map("post_mime_type") @db.VarChar(100)
  commentCount        BigInt   @default(0) @map("comment_count")

  @@index([postAuthor], map: "post_author")
  @@index([postName(length: 191)], map: "post_name")
  @@index([postParent], map: "post_parent")
  @@index([postType, postStatus, postAuthor], map: "type_status_author")
  @@index([postType, postStatus, postDate, id], map: "type_status_date")
  @@map("wp_posts")
}

model WpPostmeta {
  metaId    BigInt  @id @default(autoincrement()) @map("meta_id") @db.UnsignedBigInt
  postId    BigInt  @default(0) @map("post_id") @db.UnsignedBigInt
  metaKey   String? @map("meta_key") @db.VarChar(255)
  metaValue String? @map("meta_value") @db.LongText

  @@index([metaKey(length: 191)], map: "meta_key")
  @@index([postId], map: "post_id")
  @@map("wp_postmeta")
}

model WpTerm {
  termId    BigInt @id @default(autoincrement()) @map("term_id") @db.UnsignedBigInt
  name      String @default("") @map("name") @db.VarChar(200)
  slug      String @default("") @map("slug") @db.VarChar(200)
  termGroup BigInt @default(0) @map("term_group")
  termOrder Int?   @default(0) @map("term_order")

  @@index([name(length: 191)], map: "name")
  @@index([slug(length: 191)], map: "slug")
  @@map("wp_terms")
}

model WpTermTaxonomy {
  termTaxonomyId BigInt @id @default(autoincrement()) @map("term_taxonomy_id") @db.UnsignedBigInt
  termId         BigInt @default(0) @map("term_id") @db.UnsignedBigInt
  taxonomy       String @default("") @map("taxonomy") @db.VarChar(32)
  description    String @map("description") @db.LongText
  parent         BigInt @default(0) @map("parent") @db.UnsignedBigInt
  count          BigInt @default(0) @map("count")

  @@unique([termId, taxonomy], map: "term_id_taxonomy")
  @@index([taxonomy], map: "taxonomy")
  @@map("wp_term_taxonomy")
}

model WpTermRelationship {
  objectId       BigInt @default(0) @map("object_id") @db.UnsignedBigInt
  termTaxonomyId BigInt @default(0) @map("term_taxonomy_id") @db.UnsignedBigInt
  termOrder      Int    @default(0) @map("term_order")

  @@id([objectId, termTaxonomyId])
  @@index([termTaxonomyId], map: "term_taxonomy_id")
  @@map("wp_term_relationships")
}

model WpRedirection {
  id           BigInt   @id @default(autoincrement()) @map("id") @db.UnsignedBigInt
  sources      String   @map("sources") @db.LongText
  urlTo        String   @map("url_to") @db.Text
  headerCode   Int      @map("header_code") @db.UnsignedSmallInt
  hits         BigInt   @default(0) @map("hits") @db.UnsignedBigInt
  status       String   @default("active") @map("status") @db.VarChar(25)
  created      DateTime @default(dbgenerated("('0000-00-00 00:00:00')")) @map("created") @db.DateTime(0)
  updated      DateTime @default(dbgenerated("('0000-00-00 00:00:00')")) @map("updated") @db.DateTime(0)
  lastAccessed DateTime @default(dbgenerated("('0000-00-00 00:00:00')")) @map("last_accessed") @db.DateTime(0)

  @@index([status, updated], map: "idx_rm_status_updated")
  @@index([status], map: "status")
  @@map("wp_rank_math_redirections")
}

model BedoCategory {
  id                Int                   @id @unique(map: "id") @default(autoincrement())
  name              String?               @db.VarChar(255)
  parentId          Int?                  @map("parent_id")
  productCategories BedoProductCategory[] @ignore

  @@unique([name, parentId], map: "unique_child_parent_cat")
  @@map("bedo_category")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model BedoCategoryPath {
  catId Int    @map("cat_id")
  path  String @map("path") @db.VarChar(1500)

  @@index([catId], map: "cat_id")
  @@map("bedo_category_path")
  @@ignore
}

model BedoFileType {
  id   Int    @id @default(autoincrement())
  mime String @unique(map: "mime") @db.VarChar(30)

  @@map("bedo_file_type")
}

model BedoVersion {
  id          Int    @id @default(autoincrement())
  versionName String @unique(map: "version_index") @map("version") @db.VarChar(10)

  @@map("bedo_versions")
}

model BedoProduct {
  id            Int                   @id @unique(map: "id") @default(autoincrement())
  name          String                @unique(map: "name") @db.VarChar(500)
  catId         Int                   @map("cat_id")
  lastVersionId Int                   @map("last_version")
  code          String                @unique(map: "code") @db.VarChar(30)
  manualId      Int?                  @map("manual")
  softwareId    Int?                  @map("software")
  digitalId     Int?                  @map("digital_content")
  videoId       Int                   @map("video_learning")
  imgTypeId     Int?                  @map("img_type")
  categories    BedoProductCategory[] @ignore
  licenses      BedoProductLicense[]

  @@index([catId], map: "category_id")
  @@index([digitalId], map: "digital_content_file_type_fk")
  @@index([imgTypeId], map: "img_type_file_type_fk")
  @@index([lastVersionId], map: "last_version")
  @@index([manualId], map: "manual_file_type_fk")
  @@index([softwareId], map: "software_file_type_fk")
  @@map("bedo_products")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model BedoProductCategory {
  productId Int?          @map("product_id")
  catId     Int?          @map("cat_id")
  product   BedoProduct?  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bedo_product_categories_ibfk_1")
  category  BedoCategory? @relation(fields: [catId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bedo_product_categories_ibfk_2")

  @@unique([productId, catId], map: "unique_product_category")
  @@index([catId], map: "cat_id")
  @@map("bedo_product_categories")
  @@ignore
}

model BedoProductLicense {
  userId        BigInt      @map("user_id") @db.UnsignedBigInt
  productId     Int         @map("product_id")
  licenseKey    String      @map("license") @db.VarChar(300)
  versionId     Int         @map("version_id")
  instanceLimit Int         @map("instance_limit")
  quantity      Int?        @map("quantity")
  showLicense   Boolean?    @default(true) @map("show_license")
  user          WpUser      @relation(fields: [userId], references: [id], onUpdate: Restrict, map: "bedo_user_product_license_ibfk_1")
  product       BedoProduct @relation(fields: [productId], references: [id], onUpdate: Restrict, map: "bedo_user_product_license_ibfk_2")

  @@id([userId, productId])
  @@index([productId], map: "product_id")
  @@index([versionId], map: "version_id")
  @@map("bedo_user_product_license")
}

model BedoProductInstance {
  userId       BigInt @map("user_id") @db.UnsignedBigInt
  productId    Int    @map("product_id")
  instanceName String @unique(map: "constraint_name") @map("instance_name") @db.VarChar(500)

  @@id([userId, productId, instanceName])
  @@index([productId], map: "product_id")
  @@map("bedo_user_product_instance")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model BedoUserOrganization {
  userId    BigInt @map("user_id") @db.UnsignedBigInt
  name      String @map("name") @db.VarChar(500)
  imgTypeId Int?   @map("img_type")

  @@index([imgTypeId], map: "img_type")
  @@index([userId], map: "user_id")
  @@map("bedo_user_organization_name")
  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model BedoUserPhoneNumber {
  userId      BigInt  @default(autoincrement()) @map("user_id") @db.UnsignedBigInt
  phoneNumber String? @map("phone_number") @db.VarChar(30)
  user        WpUser  @relation(fields: [userId], references: [id], onUpdate: Restrict, map: "bedo_user_phone_numbers_ibfk_1")

  @@index([userId], map: "user_id")
  @@map("bedo_user_phone_numbers")
  @@ignore
}

model BedoDashboardPage {
  id     Int                       @id @default(autoincrement())
  name   String                    @db.VarChar(50)
  access BedoDashboardUserAccess[]

  @@map("bedo_dashboard_pages")
}

model BedoDashboardUserAccess {
  userId BigInt            @map("user_id") @db.UnsignedBigInt
  pageId Int               @map("page_id")
  user   WpUser            @relation(fields: [userId], references: [id], onUpdate: Restrict, map: "bedo_dashboard_user_access_ibfk_1")
  page   BedoDashboardPage @relation(fields: [pageId], references: [id], onUpdate: Restrict, map: "bedo_dashboard_user_access_ibfk_2")

  @@id([userId, pageId])
  @@index([pageId], map: "page_id")
  @@map("bedo_dashboard_user_access")
}

model BedoCustomerSale {
  customerId BigInt @unique(map: "unique_customer_sales") @map("customer_id") @db.UnsignedBigInt
  salesId    BigInt @map("sales_id") @db.UnsignedBigInt
  customer   WpUser @relation("CustomerUser", fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "bedo_customer_sales_ibfk_1")
  sales      WpUser @relation("SalesUser", fields: [salesId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "bedo_customer_sales_ibfk_2")

  @@id([customerId, salesId])
  @@index([salesId], map: "sales_id")
  @@map("bedo_customer_sales")
}

model wp_actionscheduler_actions {
  action_id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  hook                 String
  status               String    @db.VarChar(20)
  scheduled_date_gmt   DateTime? @default(dbgenerated("('0000-00-00 00:00:00')")) @db.DateTime(0)
  scheduled_date_local DateTime? @default(dbgenerated("('0000-00-00 00:00:00')")) @db.DateTime(0)
  args                 String?
  schedule             String?   @db.LongText
  group_id             BigInt    @default(0) @db.UnsignedBigInt
  attempts             Int       @default(0)
  last_attempt_gmt     DateTime? @default(dbgenerated("('0000-00-00 00:00:00')")) @db.DateTime(0)
  last_attempt_local   DateTime? @default(dbgenerated("('0000-00-00 00:00:00')")) @db.DateTime(0)
  claim_id             BigInt    @default(0) @db.UnsignedBigInt
  extended_args        String?   @db.VarChar(8000)
  priority             Int       @default(10) @db.UnsignedTinyInt

  @@index([args], map: "args")
  @@index([claim_id, status, priority, scheduled_date_gmt], map: "claim_id_status_priority_scheduled_date_gmt")
  @@index([claim_id, status, scheduled_date_gmt], map: "claim_id_status_scheduled_date_gmt")
  @@index([group_id], map: "group_id")
  @@index([hook], map: "hook")
  @@index([hook(length: 163), status, scheduled_date_gmt], map: "hook_status_scheduled_date_gmt")
  @@index([last_attempt_gmt], map: "last_attempt_gmt")
  @@index([scheduled_date_gmt], map: "scheduled_date_gmt")
  @@index([status], map: "status")
  @@index([status, claim_id], map: "status_claim_id")
  @@index([status, last_attempt_gmt], map: "status_last_attempt_gmt")
  @@index([status, scheduled_date_gmt], map: "status_scheduled_date_gmt")
}

model wp_actionscheduler_claims {
  claim_id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  date_created_gmt DateTime? @default(dbgenerated("('0000-00-00 00:00:00')")) @db.DateTime(0)

  @@index([date_created_gmt], map: "date_created_gmt")
}

model wp_actionscheduler_groups {
  group_id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  slug     String @db.VarChar(255)

  @@index([slug(length: 191)], map: "slug")
}

model wp_actionscheduler_logs {
  log_id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  action_id      BigInt    @db.UnsignedBigInt
  message        String    @db.Text
  log_date_gmt   DateTime? @default(dbgenerated("('0000-00-00 00:00:00')")) @db.DateTime(0)
  log_date_local DateTime? @default(dbgenerated("('0000-00-00 00:00:00')")) @db.DateTime(0)

  @@index([action_id], map: "action_id")
  @@index([log_date_gmt], map: "log_date_gmt")
}

model wp_capabilities {
  umeta_id   Int    @id @default(autoincrement())
  meta_key   String @db.VarChar(255)
  meta_value String @db.VarChar(255)
}

model wp_commentmeta {
  meta_id    BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  comment_id BigInt  @default(0) @db.UnsignedBigInt
  meta_key   String? @db.VarChar(255)
  meta_value String? @db.LongText

  @@index([comment_id], map: "comment_id")
  @@index([meta_key(length: 191)], map: "meta_key")
}

model wp_comments {
  comment_ID           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  comment_post_ID      BigInt   @default(0) @db.UnsignedBigInt
  comment_author       String   @db.TinyText
  comment_author_email String   @default("") @db.VarChar(100)
  comment_author_url   String   @default("") @db.VarChar(200)
  comment_author_IP    String   @default("") @db.VarChar(100)
  comment_date         DateTime @default(dbgenerated("('0000-00-00 00:00:00')")) @db.DateTime(0)
  comment_date_gmt     DateTime @default(dbgenerated("('0000-00-00 00:00:00')")) @db.DateTime(0)
  comment_content      String   @db.Text
  comment_karma        Int      @default(0)
  comment_approved     String   @default("1") @db.VarChar(20)
  comment_agent        String   @default("") @db.VarChar(255)
  comment_type         String   @default("comment") @db.VarChar(20)
  comment_parent       BigInt   @default(0) @db.UnsignedBigInt
  user_id              BigInt   @default(0) @db.UnsignedBigInt

  @@index([comment_approved, comment_date_gmt], map: "comment_approved_date_gmt")
  @@index([comment_author_email(length: 10)], map: "comment_author_email")
  @@index([comment_date_gmt], map: "comment_date_gmt")
  @@index([comment_parent], map: "comment_parent")
  @@index([comment_post_ID], map: "comment_post_ID")
}

model wp_duplicator_packages {
  id      BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name    String   @db.VarChar(250)
  hash    String   @db.VarChar(50)
  status  Int
  created DateTime @default(dbgenerated("('0000-00-00 00:00:00')")) @db.DateTime(0)
  owner   String   @db.VarChar(60)
  package String   @db.LongText

  @@index([hash], map: "hash")
}

model wp_duplicator_pro_entities {
  id   BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  type String @db.VarChar(100)
  data String @db.LongText

  @@index([type], map: "type_idx")
}

model wp_duplicator_pro_packages {
  id      BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name    String   @db.VarChar(250)
  hash    String   @db.VarChar(50)
  status  Int
  created DateTime @default(dbgenerated("('0000-00-00 00:00:00')")) @db.DateTime(0)
  owner   String   @db.VarChar(60)
  package String   @db.LongText

  @@index([hash], map: "hash")
}

model wp_icl_content_status {
  rid       BigInt   @id
  nid       BigInt
  timestamp DateTime @db.DateTime(0)
  md5       String   @db.VarChar(32)

  @@index([nid], map: "nid")
}

model wp_icl_core_status {
  id          BigInt  @id @default(autoincrement())
  rid         BigInt
  module      String  @db.VarChar(16)
  origin      String  @db.VarChar(64)
  target      String  @db.VarChar(64)
  status      Int     @db.SmallInt
