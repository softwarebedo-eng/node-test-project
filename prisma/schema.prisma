  @@index([object_id], map: "object_id")
}

model wp_icl_mo_files_domains {
  id             Int                                    @id @default(autoincrement())
  file_path      String                                 @db.VarChar(250)
  file_path_md5  String                                 @unique(map: "file_path_md5_UNIQUE") @db.VarChar(32)
  domain         String                                 @db.VarChar(45)
  status         String                                 @default("not_imported") @db.VarChar(20)
  num_of_strings Int                                    @default(0)
  last_modified  Int
  component_type wp_icl_mo_files_domains_component_type @default(other)
  component_id   String?                                @db.VarChar(100)
}

model wp_icl_node {
  nid         BigInt @id
  md5         String @db.VarChar(32)
  links_fixed Int    @default(0) @db.TinyInt
}

model wp_icl_reminders {
  id         BigInt @id
  message    String @db.Text
  url        String @db.Text
  can_delete Int    @db.TinyInt
  show       Int    @db.TinyInt
}

model wp_icl_string_packages {
  ID         BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  kind_slug  String  @db.VarChar(160)
  kind       String  @db.VarChar(160)
  name       String  @db.VarChar(160)
  title      String  @db.VarChar(160)
  edit_link  String  @db.Text
  view_link  String  @db.Text
  post_id    Int?
  word_count String? @db.VarChar(2000)
}

model wp_icl_string_pages {
  id        BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  string_id BigInt @db.UnsignedBigInt
  url_id    BigInt @db.UnsignedBigInt

  @@index([string_id], map: "string_id")
  @@index([url_id], map: "string_to_url_id")
}

model wp_icl_string_positions {
  id               BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  string_id        BigInt
  kind             Int?   @db.TinyInt
  position_in_page String @db.VarChar(255)

  @@index([string_id], map: "string_id")
}

model wp_icl_string_status {
  id                    BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  rid                   BigInt
  string_translation_id BigInt
  timestamp             DateTime @default(now()) @db.Timestamp(0)
  md5                   String   @db.VarChar(32)

  @@index([string_translation_id], map: "string_translation_id")
}

model wp_icl_string_translations {
  id                  BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  string_id           BigInt   @db.UnsignedBigInt
